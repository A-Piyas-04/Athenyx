{
  "duration": 99.0,
  "voice": {
    "style": "Warm, upbeat, friendly narrator. Conversational, a little playful, not salesy. Medium-fast pace with a smile in the voice.",
    "lines": [
      {
        "scene": "hook",
        "start": 0.2,
        "end": 2.8,
        "text": "Shipping code all alone?"
      },
      {
        "scene": "team",
        "start": 3.3,
        "end": 9.1,
        "text": "Meet your code's dream team: nine AI specialists, from security to clean code."
      },
      {
        "scene": "p1",
        "start": 9.75,
        "end": 13.65,
        "text": "Security Adversary: thinks like a hacker and finds open doors."
      },
      {
        "scene": "p2",
        "start": 14.15,
        "end": 18.05,
        "text": "Architecture Skeptic: asks if your design really needs all that."
      },
      {
        "scene": "p3",
        "start": 18.55,
        "end": 22.45,
        "text": "Data Integrity Auditor: makes sure every number adds up."
      },
      {
        "scene": "p4",
        "start": 22.95,
        "end": 26.85,
        "text": "Reliability and Performance Engineer: keeps your app fast and steady."
      },
      {
        "scene": "p5",
        "start": 27.35,
        "end": 31.25,
        "text": "Quality and Testing Critic: finds the cases your tests miss."
      },
      {
        "scene": "p6",
        "start": 31.75,
        "end": 35.65,
        "text": "Product and UX Guardian: keeps it simple for real people."
      },
      {
        "scene": "p7",
        "start": 36.15,
        "end": 40.05,
        "text": "DevOps and Operations Auditor: makes launches and rollbacks smooth."
      },
      {
        "scene": "p8",
        "start": 40.55,
        "end": 44.45,
        "text": "Algorithm and Data Structure Specialist: spots slow code early."
      },
      {
        "scene": "p9",
        "start": 44.95,
        "end": 48.85,
        "text": "Code Quality and Maintainability Engineer: keeps code easy to change."
      },
      {
        "scene": "checkup",
        "start": 49.3,
        "end": 53.5,
        "text": "Athenyx gives your project a checkup, and shows what needs attention first."
      },
      {
        "scene": "ask",
        "start": 54.1,
        "end": 58.3,
        "text": "Ask anything about your code. Nothing runs until you press start."
      },
      {
        "scene": "experts",
        "start": 58.9,
        "end": 63.1,
        "text": "Then the right two or three experts jump in."
      },
      {
        "scene": "proof",
        "start": 63.7,
        "end": 67.7,
        "text": "Every finding cites the exact line. No proof? No finding."
      },
      {
        "scene": "bugs",
        "start": 68.3,
        "end": 71.7,
        "text": "Bugs don't stand a chance."
      },
      {
        "scene": "pick",
        "start": 72.3,
        "end": 76.7,
        "text": "Compare fixes side by side. Safe, smart, or fast. You pick."
      },
      {
        "scene": "ledger",
        "start": 77.3,
        "end": 81.5,
        "text": "It remembers every decision, and why you made it."
      },
      {
        "scene": "ship",
        "start": 82.1,
        "end": 86.1,
        "text": "Before release, get an honest read on whether it's safe to ship."
      },
      {
        "scene": "decide",
        "start": 86.7,
        "end": 90.5,
        "text": "It never touches your code. They advise. You decide."
      },
      {
        "scene": "free",
        "start": 91.1,
        "end": 95.1,
        "text": "Your dream team is free. Sign in with GitHub."
      },
      {
        "scene": "end",
        "start": 95.7,
        "end": 98.6,
        "text": "Athenyx. Your code's dream team."
      }
    ]
  },
