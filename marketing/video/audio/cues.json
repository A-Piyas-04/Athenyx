    "lines": [
      { "scene": "hook",    "start": 0.2,  "end": 2.8,  "text": "Shipping code all alone?" },
      { "scene": "team",    "start": 3.3,  "end": 9.1,  "text": "Meet your code's dream team: nine AI specialists, from security to clean code." },
      { "scene": "checkup", "start": 9.7,  "end": 13.9, "text": "Athenyx gives your project a checkup, and shows what needs attention first." },
      { "scene": "ask",     "start": 14.5, "end": 18.7, "text": "Ask anything about your code. Nothing runs until you press start." },
      { "scene": "experts", "start": 19.3, "end": 23.5, "text": "Then the right two or three experts jump in." },
      { "scene": "proof",   "start": 24.1, "end": 28.1, "text": "Every finding cites the exact line. No proof? No finding." },
      { "scene": "bugs",    "start": 28.7, "end": 32.1, "text": "Bugs don't stand a chance." },
      { "scene": "pick",    "start": 32.7, "end": 37.1, "text": "Compare fixes side by side. Safe, smart, or fast. You pick." },
      { "scene": "ledger",  "start": 37.7, "end": 41.9, "text": "It remembers every decision, and why you made it." },
      { "scene": "ship",    "start": 42.5, "end": 46.5, "text": "Before release, get an honest read on whether it's safe to ship." },
      { "scene": "decide",  "start": 47.1, "end": 50.9, "text": "It never touches your code. They advise. You decide." },
      { "scene": "free",    "start": 51.5, "end": 55.5, "text": "Your dream team is free. Sign in with GitHub." },
